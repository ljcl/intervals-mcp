# Dependencies (installed inside container)
**/node_modules/

# Build artifacts (built inside container)
**/dist/
**/.turbo/

# Git
.git/
.gitignore

# Worktrees
.worktrees/

# Coverage
coverage/
.coverage

# Test artifacts
test-results/

# Environment
.env
.env.*
!.env.example

# Docs
docs/
*.md
!README.md

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Docker
**/Dockerfile
docker-compose.yml
.dockerignore

# Storybook build output
**/storybook-static/

# Python venv
.venv/

# Pytest
.pytest_cache/

# Tests, fixtures and stories never ship: the runner copies apps/server/src
# wholesale, and fixtures are captured from a real account.
**/__fixtures__/
**/*.test.ts
**/*.test.tsx
**/*.stories.tsx
