# Dependencies (installed inside container)
**/node_modules/

# Build artifacts (built inside container)
**/dist/
**/.turbo/

# Git
.git/
.gitignore

# Worktrees
.worktrees/

# Coverage
coverage/
.coverage

# Test artifacts
test-results/

# Environment
.env
.env.*
!.env.example

# Docs
docs/
*.md
!README.md
# The skills the server serves over MCP (apps/server/src/skills.ts) are
# Markdown the image needs.
!apps/server/skills/**

# IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Docker
**/Dockerfile
docker-compose.yml
.dockerignore

# Storybook build output
**/storybook-static/

# Python venv
.venv/

# Pytest
.pytest_cache/

# Tests, fixtures and stories never ship: they would bloat the build context
# and invalidate the build stage's cache, and fixtures are captured from a
# real account. (The runner copies only the apps/server/dist bundle.)
**/__fixtures__/
**/*.test.ts
**/*.test.tsx
**/*.stories.tsx
