# intervals.icu personal API key (intervals.icu, Settings, Developer Settings)
INTERVALS_API_KEY=

# Optional: athlete id. 0 (default) means the key's own athlete.
INTERVALS_ATHLETE_ID=0

# Time zone for local dates
TZ=Australia/Sydney

# Optional: public tunnel URL (only used to warn when /mcp is unprotected)
PUBLIC_URL=

# Optional but strongly recommended when exposed through a tunnel: shared
# secret gating /mcp. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: directory for exported GPX files
ROUTE_EXPORT_PATH=
