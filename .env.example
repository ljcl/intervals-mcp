# intervals.icu personal API key (intervals.icu, Settings, Developer Settings)
INTERVALS_API_KEY=

# Optional: athlete id. 0 (default) means the key's own athlete.
INTERVALS_ATHLETE_ID=0

# Optional: IANA time zone for today and default date ranges, e.g. Australia/Sydney.
# Leave blank (or UTC) to use the athlete's time zone from intervals.icu; Etc/UTC pins UTC.
TZ=

# Optional: OpenRouteService key (openrouteservice.org, free Standard plan) for
# generated route suggestions. Unset: route suggestions offer past runs only.
# Start, end and via points are sent to OpenRouteService.
ORS_API_KEY=

# Optional: usual run start as lat,lng. Unset: inferred from recent GPS runs.
HOME_START=

# Optional: public tunnel URL (only used to warn when /mcp is unprotected)
PUBLIC_URL=

# Optional but strongly recommended when exposed through a tunnel: shared
# secret gating /mcp. At least 32 characters; generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: port (default 3000; docker-compose.yml pins 3000).
# PORT=3000
