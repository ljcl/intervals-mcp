{
  "name": "intervals-mcp",
  "version": "2.9.3",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:scripts": "bun test scripts",
    "test:stories": "vitest run --config vitest.stories.config.ts --project storybook",
    "test:stories:coverage": "bun scripts/coverage-ratchet-guard.ts vitest.stories.config.ts -- vitest run --config vitest.stories.config.ts --project storybook --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "boundaries": "turbo boundaries",
    "check": "turbo run lint knip test typecheck typecheck:root build && turbo boundaries && bun run test:scripts",
    "check:affected": "turbo run //#lint //#knip //#typecheck:root && turbo run test typecheck build --affected && turbo boundaries && bun run test:scripts",
    "build:affected": "turbo run build --affected",
    "typecheck:affected": "turbo run //#typecheck:root && turbo run typecheck --affected",
    "knip": "knip",
    "audit": "bun scripts/audit.ts",
    "storybook": "turbo run storybook --filter=@intervals-mcp/storybook",
    "build-storybook": "turbo run build:storybook --filter=@intervals-mcp/storybook",
    "coverage:summary": "bun scripts/coverage-summary.ts",
    "shots": "bun scripts/story-shots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@intervals-mcp/tsconfig": "workspace:*",
    "@storybook/addon-vitest": "10.6.2",
    "@types/bun": "1.4.3",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.8",
    "knip": "6.42.1",
    "playwright": "1.64.1",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "react-is": "19.3.0"
  }
}
