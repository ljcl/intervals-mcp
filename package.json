{
  "name": "intervals-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:stories": "vitest run --config vitest.stories.config.ts --project storybook",
    "test:stories:coverage": "vitest run --config vitest.stories.config.ts --project storybook --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "boundaries": "turbo boundaries",
    "check": "turbo run lint test typecheck build && turbo boundaries",
    "check:affected": "turbo run lint test typecheck build --affected && turbo boundaries",
    "build:affected": "turbo run build --affected",
    "typecheck:affected": "turbo run typecheck --affected",
    "knip": "knip",
    "storybook": "turbo run storybook --filter=@intervals-mcp/storybook",
    "build-storybook": "turbo run build:storybook --filter=@intervals-mcp/storybook",
    "coverage:summary": "bun scripts/coverage-summary.ts",
    "shots": "bun scripts/story-shots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "knip": "6.32.2",
    "playwright": "1.62.1",
    "turbo": "2.10.10",
    "vitest": "4.1.10"
  },
  "overrides": {
    "react-is": "19.2.8"
  }
}
