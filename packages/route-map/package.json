{
  "name": "@intervals-mcp/route-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app.html": "./dist/app.html"
  },
  "scripts": {
    "build": "INPUT=app.html vite build",
    "dev": "INPUT=app.html vite build --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@intervals-mcp/data": "workspace:*",
    "@intervals-mcp/design-system": "workspace:*",
    "@intervals-mcp/ui": "workspace:*",
    "maplibre-gl": "6.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@intervals-mcp/tsconfig": "workspace:*",
    "@intervals-mcp/vite-config": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "storybook": "10.5.8",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
